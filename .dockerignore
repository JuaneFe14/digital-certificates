# =============================================================================
# .dockerignore
# =============================================================================
# Excluye archivos innecesarios del build context de Docker.
# Reduce tamano del contexto y evita filtrar secrets (key.pem).
# =============================================================================

# Git
.git/
.gitignore

# Certificados (generados dinamicamente, nunca en la imagen)
certs/

# Docker (no necesario dentro del contenedor)
docker/nginx/
docker-compose.yml
docker-compose.override.yml

# Scripts
scripts/

# Documentacion
README.md
AGENTS.md

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
venv/
.venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
